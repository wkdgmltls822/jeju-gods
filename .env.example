# 복사해서 .env.local 로 이름을 바꾸고 값을 채우세요. (.env.local 은 절대 공개 저장소에 올리지 마세요)
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 서버(/api)에서만 쓰는 비밀 키 — VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=
ANTHROPIC_API_KEY=
# Claude 모델: haiku(개발·테스트, 기본) 또는 sonnet(시연 영상·발표). 키가 아니라서 노출돼도 괜찮다
CLAUDE_MODEL=haiku

# 임시용 (Claude 키가 없을 때만 사용)
GEMINI_API_KEY=
